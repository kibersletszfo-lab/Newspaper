# User-provided paper, uncompressed RGBA DDS; no vanilla eventwindow override.
textformatting = { format = { name = nfp34_ink format = "color:{ 0.07, 0.06, 0.05, 1.0 }" } }
types nfp34_types {
type nfp34_paper_panel = window {
name = nfp34_paper_panel
parentanchor = center movable = yes layer = popups allow_outside = yes
size = { 902 1018 }
scale = "[ScaleToFitElementInside('(int32)1920', '(int32)1080')]"

datacontext = "[GetPlayer.MakeScope.Var('nfp_selected_issue').GetScriptContainer]"
visible = "[And(And(And(And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp_window_open').GetValue, '(CFixedPoint)1'), Not(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet)), And(Not(GetVariableSystem.HasValue('nfp_view', 'settings')), And(GetPlayer.MakeScope.Var('nfp_selected_issue').IsSet, GetPlayer.MakeScope.Var('nfp_selected_issue').GetScriptContainer.HasVariable('nfp30_schema')))), Not(IsPauseMenuShown)), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0')))]"
