types nfp_types {
    type nfp_panel = default_popup {
        size = { 1000 690 }
        scale = "[ScaleToFitElementInside('(int32)1920', '(int32)1080')]"
        visible = "[And(And(And(And(Or(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp_window_open').GetValue, '(CFixedPoint)1')), Not(And(And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp_window_open').GetValue, '(CFixedPoint)1'), Not(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet)), And(Not(GetVariableSystem.HasValue('nfp_view', 'settings')), And(GetPlayer.MakeScope.Var('nfp_selected_issue').IsSet, GetPlayer.MakeScope.Var('nfp_selected_issue').GetScriptContainer.HasVariable('nfp30_schema')))))), Not(IsPauseMenuShown)), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0'))), Not(Or(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet, GetVariableSystem.HasValue('nfp_view', 'settings'))))]"
        blockoverride "window_header_name" { text = "NFP30_TITLE" }
        blockoverride "header_close_button_visibility" { visible = yes }
        blockoverride "header_close_button" { onclick = "[GetScriptedGui('nfp_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
        state = {
            name = _show
            on_start = "[GetVariableSystem.Set('nfp_page', '0')]"
        }
        blockoverride "content" {
            widget = {
                position = { 45 88 }
                size = { 920 565 }
                button = {
                    using = default_button
                    position = { 0 0 }
                    size = { 165 34 }
                    text = "NFP_SETTINGS"
                    onclick = "[GetVariableSystem.Set('nfp_view', 'settings')]"

                }
                button = {
                    using = default_button
                    position = { 180 0 }
                    size = { 165 34 }
                    text = "NFP_READER"
                    onclick = "[GetVariableSystem.Set('nfp_view', 'reader')]"
                    enabled = "[Not(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet)]"
                }
                textbox = {
                    position = { 370 4 }
                    size = { 540 32 }
                    text = "NFP_COUNTRY"
                    multiline = yes
                    align = left|nobaseline

                }
                # Subscription settings moved to the standalone paper form.
                widget = {
                    position = { 0 45 }
                    size = { 920 520 }
                    visible = "[And(Not(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet), Not(GetVariableSystem.HasValue('nfp_view', 'settings')))]"

                    textbox = {
                        position = { 0 0 }
                        size = { 170 36 }
                        text = "NFP_ARCHIVE"
                        multiline = yes
                        align = left|nobaseline

                    }
                    # Explicit oldest-to-newest rows; independent of recycled list/grid slots.
                    widget = {
                        position = { 0 43 }
                        size = { 170 25 }
                        visible = "[GetPlayer.MakeScope.Var('nfp_archive_row_1').IsSet]"
                        datacontext = "[GetPlayer.MakeScope.Var('nfp_archive_row_1').GetScriptContainer]"
                        button = {
                            using = default_button
                            size = { 165 25 }
                            text = "NFP_ARCHIVE_ITEM"
                            onclick = "[GetScriptedGui('nfp_select_issue').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('nfp_issue', ScriptContainer.MakeScope).End)]"
                            onclick = "[GetVariableSystem.Set('nfp_page', '0')]"
onclick = "[GetVariableSystem.Set(Concatenate3('nfp30_page_', GetPlayer.GetName, Concatenate('_', ToString_int32(FixedPointToInt(ScriptContainer.GetVariableValue('nfp_number'))))), Select_CString(EqualTo_CFixedPoint(ScriptContainer.GetVariableValue('nfp_kind'), '(CFixedPoint)3'), '1', '0'))]"

                        }
                    }
                    widget = {
                        position = { 0 70 }
                        size = { 170 25 }
                        visible = "[GetPlayer.MakeScope.Var('nfp_archive_row_2').IsSet]"
