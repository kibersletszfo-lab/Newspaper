# Uses vanilla components and a bundled News Events newspaper icon. No vanilla GUI overrides.
types nfp47_types {
type nfp47_subscription_panel = window {
name = nfp47_subscription_panel
parentanchor = center movable = yes layer = popups allow_outside = yes
size = { 1120 840 }
scale = "[ScaleToFitElementInside('(int32)1920', '(int32)1080')]"
datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
visible = "[And(IsInGame, And(Or(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet, And(EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp_window_open').GetValue, '(CFixedPoint)1'), GetVariableSystem.HasValue('nfp_view', 'settings'))), And(Not(IsPauseMenuShown), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0')))))]"
icon = { name = nfp47_paper size = { 100% 100% } texture = "gfx/interface/nfp_paper/subscription.dds" alwaystransparent = yes }

button = { name = nfp47_close position = { 1054 24 } size = { 44 44 }
using = close_button_sound
texture = "gfx/interface/buttons/round_button_small_bg.dds"
effectname = "NoHighlight"
tooltip = "NFP30_PAPER_CLOSE"
onclick = "[GetScriptedGui('nfp_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
icon = { size = { 100% 100% } texture = "gfx/interface/buttons/round_button_small_wood.dds" alwaystransparent = yes }
icon = { name = nfp47_close_frame size = { 100% 100% } texture = "gfx/interface/buttons/round_button_small_frame.dds" alwaystransparent = yes
modify_texture = { name = nfp47_close_hover texture = "gfx/interface/buttons/round_button_frame_mouse_enter.dds" blend_mode = overlay alpha = 0 }
state = { name = enter duration = 0.12 modify_texture = { name = nfp47_close_hover alpha = 1 } }
state = { name = leave duration = 0.12 modify_texture = { name = nfp47_close_hover alpha = 0 } }
}
icon = { size = { 68% 68% } parentanchor = center widgetanchor = center texture = "gfx/interface/buttons/button_icons/close.dds" alwaystransparent = yes }
state = { name = _mouse_enter on_start = "[PdxGuiWidget.AccessChild('nfp47_close_frame').TriggerAnimation('enter')]" }
state = { name = _mouse_leave on_start = "[PdxGuiWidget.AccessChild('nfp47_close_frame').TriggerAnimation('leave')]" }
}
