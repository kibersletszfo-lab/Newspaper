widget = {
    name = nfp_root
widget = { name = nfp40_session_init size = { 1 1 } alwaystransparent = yes
visible = "[And(IsInGame, And(GetPlayer.IsValid, Not(GetVariableSystem.HasValue('nfp40_session_ready', 'true'))))]"
state = { name = _show on_start = "[GetScriptedGui('nfp40_reset_event_cover').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
on_start = "[GetVariableSystem.Set('nfp40_session_ready', 'true')]" }
}
    size = { 100% 100% }
    datacontext = "[GetMetaPlayer.GetPlayedOrObservedCountry]"
    visible = "[GetPlayer.IsValid]"
    # Vanilla time block: rightmost 440x80; construction: rightmost 410x75 at Y=76.
    # Button occupies X=[screen_right-484, screen_right-420], Y=[82,146].
    # Both anchors explicit: 10 logical pixels left of construction, 2 below clock.
    widget = {
        name = nfp_launcher
        parentanchor = top|right
        widgetanchor = top|right
        position = { -420 82 }
        size = { 64 64 }
        visible = "[And(IsInGame, And(Not(Or(IsPauseMenuShown, IsGameOverScreenShown)), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0'))))]"
        allow_outside = yes
        icon = {
            name = nfp_launcher_glow
            using = rotate_glow_animation_02
            using = fullscreen_hide
            parentanchor = center
            widgetanchor = center
            size = { 128% 128% }
            alpha = 0.45
            alwaystransparent = yes
        }
        button = {
            name = nfp_open_button
            using = select_button_sound
            using = fullscreen_hide
            size = { 100% 100% }
            texture = "gfx/interface/buttons/round_button_big_bg.dds"
            effectname = "NoHighlight"
            tooltip = "[SelectLocalization(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)0'), 'NFP38_BADGE_HINT', 'NFP30_OPEN')]"
            onclick = "[GetScriptedGui('nfp_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetVariableSystem.Set('nfp_view', 'reader')]"
            icon = {
                name = nfp_private_wood
                size = { 100% 100% }
                texture = "gfx/interface/buttons/round_button_big_wood_action.dds"
                alwaystransparent = yes
            }
            icon = {
                name = nfp_private_frame
                size = { 100% 100% }
                texture = "gfx/interface/buttons/round_button_big_frame.dds"
                alwaystransparent = yes
                modify_texture = {
                    name = nfp_private_hover
                    texture = "gfx/interface/buttons/round_button_frame_mouse_enter.dds"
                    blend_mode = overlay
                    alpha = 0
                }
                state = { name = enter duration = 0.12
                    modify_texture = { name = nfp_private_hover alpha = 1 } }
                state = { name = leave duration = 0.12
                    modify_texture = { name = nfp_private_hover alpha = 0 } }
                state = { name = press duration = 0.06
                    modify_texture = { name = nfp_private_hover alpha = 0.25 } }
            }
            icon = {
                name = nfp_private_paper
                size = { 54 54 }
                parentanchor = center
                widgetanchor = center
                texture = "gfx/interface/icons/nfp_newspaper.dds"
                alwaystransparent = yes
                state = { name = enter duration = 0.12 size = { 60 60 } }
                state = { name = leave duration = 0.12 size = { 54 54 } }
                state = { name = press duration = 0.06 size = { 58 58 } }
            }
            state = { name = _mouse_enter on_start = "[PdxGuiWidget.AccessChild('nfp_private_frame').TriggerAnimation('enter')]" on_start = "[PdxGuiWidget.AccessChild('nfp_private_paper').InterruptThenTriggerAnimation('leave','enter')]" }
            state = { name = _mouse_leave on_start = "[PdxGuiWidget.AccessChild('nfp_private_frame').TriggerAnimation('leave')]" on_start = "[PdxGuiWidget.AccessChild('nfp_private_paper').InterruptThenTriggerAnimation('enter','leave')]" }
            state = { name = _mouse_press on_start = "[PdxGuiWidget.AccessChild('nfp_private_frame').TriggerAnimation('press')]" on_start = "[PdxGuiWidget.AccessChild('nfp_private_paper').InterruptThenTriggerAnimation('enter','press')]" }
            state = { name = _mouse_release on_start = "[PdxGuiWidget.AccessChild('nfp_private_frame').TriggerAnimation('enter')]" on_start = "[PdxGuiWidget.AccessChild('nfp_private_paper').InterruptThenTriggerAnimation('press','enter')]" }
        widget = { name = nfp38_badge position = { 39 43 } size = { 26 26 } alwaystransparent = yes
visible = "[And(GetPlayer.MakeScope.Var('nfp38_unread_count').IsSet, GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)0'))]"
icon = { size = { 26 26 } texture = "gfx/interface/buttons/round_button_small_bg.dds" alwaystransparent = yes }
icon = { size = { 26 26 } texture = "gfx/interface/buttons/round_button_small_frame.dds" alwaystransparent = yes }
icon = { name = nfp45_badge_1 position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/1.dds"
visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)1')]" alwaystransparent = yes }
icon = { name = nfp45_badge_2 position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/2.dds"
visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)2')]" alwaystransparent = yes }
icon = { name = nfp45_badge_3 position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/3.dds"
visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)3')]" alwaystransparent = yes }
icon = { name = nfp45_badge_4 position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/4.dds"
visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)4')]" alwaystransparent = yes }
icon = { name = nfp45_badge_5 position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/5.dds"
visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)5')]" alwaystransparent = yes }
icon = { name = nfp45_badge_5plus position = { 0 0 } size = { 26 26 }
texture = "gfx/interface/nfp_press/badge_digits/5plus.dds"
visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp38_unread_count').GetValue, '(CFixedPoint)5')]" alwaystransparent = yes }
}
        }
    }
    widget = { name = nfp38_init_watcher size = { 0 0 } alwaystransparent = yes
visible = "[And(IsInGame, Not(GetPlayer.MakeScope.Var('nfp39_style_version').IsSet))]"
state = { name = _show on_start = "[GetScriptedGui('nfp38_refresh_ui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
}
widget = { name = nfp38_pause_watcher size = { 0 0 } alwaystransparent = yes
visible = "[And(IsInGame, And(IsPauseMenuShown, Or(GetPlayer.MakeScope.Var('nfp_setup_pending').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.Var('nfp_window_open').GetValue, '(CFixedPoint)1'))))]"
state = { name = _show on_start = "[GetScriptedGui('nfp_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
}
widget = { name = nfp51_special_running size = { 1 1 } alwaystransparent = yes
 visible = "[And(And(IsInGame, And(Not(IsGameOverScreenShown), And(GetPlayer.MakeScope.Var('nfp51_special_attention').IsSet, And(GetPlayer.MakeScope.Var('nfp51_pending_special').IsSet, And(Not(IsPauseMenuShown), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0'))))))), And(Not(TimeKeeper.IsPaused), TimeKeeper.CanTogglePause))]"
 state = { name = _show
 on_start = "[TimeKeeper.TogglePause]"
 on_start = "[GetVariableSystem.Clear('nfp_view')]"
on_start = "[GetVariableSystem.Set(Concatenate3('nfp30_page_', GetPlayer.GetName, Concatenate('_', ToString_int32(FixedPointToInt(GetPlayer.MakeScope.Var('nfp51_pending_special').GetScriptContainer.GetVariableValue('nfp_number'))))), '1')]"

on_start = "[GetScriptedGui('nfp51_focus_special').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 }
}
widget = { name = nfp51_special_paused size = { 1 1 } alwaystransparent = yes
 visible = "[And(And(IsInGame, And(Not(IsGameOverScreenShown), And(GetPlayer.MakeScope.Var('nfp51_special_attention').IsSet, And(GetPlayer.MakeScope.Var('nfp51_pending_special').IsSet, And(Not(IsPauseMenuShown), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('nfp40_event_count').GetValue, '(CFixedPoint)0'))))))), TimeKeeper.IsPaused)]"
 state = { name = _show
 
 on_start = "[GetVariableSystem.Clear('nfp_view')]"
